#!/usr/bin/env python3
"""Unix shim so `tdf flash` works once tools/ is on PATH (see export.sh),
matching tools/tdf.cmd on Windows. `tdf.py` remains a working alias.
"""
import os
import runpy
from pathlib import Path

os.environ["TDF_PROG"] = "tdf"
runpy.run_path(str(Path(__file__).resolve().with_name("tdf.py")), run_name="__main__")
